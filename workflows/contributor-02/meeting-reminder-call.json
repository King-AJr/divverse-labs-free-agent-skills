    {"parameters":{"jsCode":"const now=DateTime.now(); const contacted=new Set($('Get rows to check who has already been contacted').all().map(i=>`${i.json['Event ID']}::${i.json['Phone Number']}`)); const out=[]; for(const item of $input.all()){const e=item.json; const start=DateTime.fromISO(e.start?.dateTime||e.start); if(!start.isValid)continue; const minutes=start.diff(now,'minutes').minutes; if(minutes<15||minutes>30)continue; const attendees=(e.attendees||[]).map(a=>({name:a.displayName||a.email||'Attendee',email:a.email||'',phone:a.phone||a.phoneNumber||''})).filter(a=>a.phone); attendees.forEach((a,index)=>{const key=`${e.id}::${a.phone}`; if(!contacted.has(key))out.push({json:{eventId:e.id,eventTitle:e.summary||'Upcoming meeting',startTime:start.toISO(),meetingLink:e.hangoutLink||e.location||'',attendeeName:a.name,attendeeEmail:a.email,phone:a.phone,isFirstAttendee:index===0}});}); } return out;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[672,0],"id":"filter-window","name":"Filter Events Within Time Window"},
