    {"parameters":{"from":"REPLACE_WITH_TWILIO_FROM_NUMBER","to":"={{ $json.phone }}","twiml":"=<Response><Say>Hello {{ $json.attendeeName }}. This is a reminder that {{ $json.eventTitle }} begins in about {{ Math.round(DateTime.fromISO($json.startTime).diffNow('minutes').minutes) }} minutes. Please get ready to join.</Say></Response>"},"type":"n8n-nodes-base.twilio","typeVersion":1,"position":[1344,-96],"id":"call-first","name":"Alert First Attendee Through a Voice Call"},
