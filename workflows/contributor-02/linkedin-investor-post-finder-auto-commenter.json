    {"parameters":{"jsCode":"const norm=u=>u?String(u).split('?')[0].replace(/\\/$/,'').trim().toLowerCase():null; const seen=new Set(); for(const x of $('Get Existing Non-Founders').all()){const u=norm(x.json['Profile Url']); if(u)seen.add(u);} for(const x of $('Get Existing Founders').all()){const u=norm(x.json['Profile Url (Founder)']); if(u)seen.add(u);} return $('Extract Commenter and Liker Profiles').all().filter(x=>{const u=norm(x.json.profileUrl); return u&&!seen.has(u);});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2464,2960],"id":"dedupe-profiles","name":"Filter Existing Profiles"},
