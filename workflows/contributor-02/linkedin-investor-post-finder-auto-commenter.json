    {"parameters":{"modelId":{"__rl":true,"value":"gpt-4.1-mini","mode":"list"},"responses":{"values":[{"content":"=LinkedIn Post: {{ $json.text }}\nAuthor Headline: {{ $json.authorHeadline }}\nPost URL: {{ $json.url }}\nAuthor Profile URL: {{ $json.authorProfileUrl.split('?')[0] }}"},{"role":"system","content":"Identify posts written by investors who are currently soliciting startup/founder investment applications. Qualify only when the author is clearly an investor, the post states current investment intent, gives concrete investment terms or stage, and includes an actionable founder CTA. Return pure JSON with qualifies, investor_name, investor_title, investor_linkedin_url, investment_focus, call_to_action, post_url, relevance_score, rejection_reason."}]},"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.1,"position":[992,2960],"id":"classify-investor-post","name":"Classify If Post From Investor Investing In Founders"},
