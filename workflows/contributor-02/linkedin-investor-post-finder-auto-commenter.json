    {"parameters":{"jsCode":"function extract(post,investorUrl){const out=[],seen=new Set(),inv=(investorUrl||'').toLowerCase().replace(/\\/$/,''); const base={postText:post.text||'',postUrl:post.url||'',postAuthorName:post.authorName||'',postAuthorProfileUrl:post.authorProfileUrl||'',postDatePosted:post.postedAtISO||''}; for(const c of post.comments||[]){if(!c.author)continue; const p=c.author,u=p.publicId?`https://www.linkedin.com/in/${p.publicId}`:''; if(u.toLowerCase().replace(/\\/$/,'')===inv)continue; out.push({...base,engagementType:'comment',profileUrl:u,firstName:p.firstName||'',lastName:p.lastName||'',occupation:p.occupation||'',commentText:c.text||'',commentLink:c.link||''}); seen.add(p.id||u);} for(const r of post.reactions||[]){if(!r.profile)continue; const p=r.profile,u=p.publicId?`https://www.linkedin.com/in/${p.publicId}`:''; if(u.toLowerCase().replace(/\\/$/,'')===inv||seen.has(p.id||u))continue; out.push({...base,engagementType:'like',profileUrl:u,firstName:p.firstName||'',lastName:p.lastName||'',occupation:p.occupation||''});} return out;} const posts=$('Scrape LinkedIn Posts').all(), result=[]; for(const q of $input.all()){const p=posts.find(x=>x.json.url===q.json.post_url); if(p)result.push(...extract(p.json,q.json.investor_linkedin_url));} return result.map(json=>({json}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1792,2960],"id":"extract-engagers","name":"Extract Commenter and Liker Profiles"},
