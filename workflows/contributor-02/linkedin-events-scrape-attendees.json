    {"parameters":{"jsCode":"const eventUrl=$('Limit Events').item.json.event_url; const match=String(eventUrl||'').match(/events\/(\d+)/); if(!match)throw new Error('LinkedIn event ID not found'); const eventId=match[1]; return Array.from({length:5},(_,i)=>{const page=i+1; const urn=encodeURIComponent(`urn:li:event:${eventId}`); return {json:{eventId,page,attendeesUrl:`https://www.linkedin.com/search/results/people/?eventUrn=${urn}&origin=EVENT_PAGE_CANNED_SEARCH&page=${page}&spellCorrectionEnabled=true`}}});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1568,0],"id":"pagination","name":"Create Attendee Pagination"},
