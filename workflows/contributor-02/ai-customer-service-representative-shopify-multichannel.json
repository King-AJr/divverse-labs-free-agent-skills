  "nodes":[
    {"parameters":{"updates":["message"],"additionalFields":{}},"type":"n8n-nodes-base.telegramTrigger","typeVersion":1.2,"position":[0,0],"id":"telegram-trigger","name":"Telegram Trigger"},
    {"parameters":{"httpMethod":"POST","path":"whatsapp/new-message","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,176],"id":"whatsapp-webhook","name":"WhatsApp Trigger","disabled":true},
    {"parameters":{"jsCode":"const d=$json; if(d.message?.from?.id){return {json:{platform:'telegram',platformId:String(d.message.from.id),text:d.message.text||'',rawData:d.message}};} const v=d.body?.entry?.[0]?.changes?.[0]?.value; if(v?.messages?.length){const m=v.messages[0]; return {json:{platform:'whatsapp',platformId:m.from,text:m.type==='text'?(m.text?.body||''):`[${m.type} message]`,rawData:v}};} return {json:{platform:'unknown',platformId:'',text:'',rawData:d}};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[240,80],"id":"normalizer","name":"Platform Normalizer"},
    {"parameters":{"operation":"executeQuery","query":"INSERT INTO auth_sessions(platform,platform_id,stage,last_interaction) VALUES ('{{ $json.platform }}','{{ $json.platformId }}','start',NOW()) ON CONFLICT(platform,platform_id) DO UPDATE SET last_interaction=NOW(); SELECT cp.shopify_customer_id IS NOT NULL AS is_linked, cp.shopify_customer_id, COALESCE(a.stage,'start') stage, a.email FROM auth_sessions a LEFT JOIN customer_platform_ids cp ON cp.platform=a.platform AND cp.platform_id=a.platform_id WHERE a.platform='{{ $json.platform }}' AND a.platform_id='{{ $json.platformId }}' LIMIT 1;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[464,80],"id":"auth-check","name":"Check Platform Auth","alwaysOutputData":true},
