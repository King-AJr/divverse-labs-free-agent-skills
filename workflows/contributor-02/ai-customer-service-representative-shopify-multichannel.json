    {"parameters":{"operation":"executeQuery","query":"SELECT COALESCE(shopify_customer_id,'NOT_FOUND') shopify_customer_id, first_name,last_name,email FROM shopify_customers WHERE EXISTS (SELECT 1 FROM customer_platform_ids c WHERE c.shopify_customer_id=shopify_customers.shopify_customer_id AND c.platform='{{ $('Platform Normalizer').first().json.platform }}' AND c.platform_id='{{ $('Platform Normalizer').first().json.platformId }}') LIMIT 1;","options":{}},"type":"n8n-nodes-base.postgresTool","typeVersion":2.6,"position":[1600,400],"id":"customer-id","name":"Get Shopify Customer ID"},
