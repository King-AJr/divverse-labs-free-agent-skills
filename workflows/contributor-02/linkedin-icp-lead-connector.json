    {"parameters":{"promptType":"define","text":"=Last message: {{ $('Group Latest and Previous Messages').first().json.lastMessage }}\nPrevious messages: {{ JSON.stringify($('Group Latest and Previous Messages').first().json.previousMessages) }}\nStage: {{ $('Determine Engagement State').item.json.stage }}\nWarmth: {{ $('Determine Engagement State').item.json.warmth }}\nFirst name: {{ $('Get Lead Info').first().json['First Name'] }}\nJob title: {{ $('Get Lead Info').first().json['Job Title'] }}\nCompany: {{ $('Get Lead Info').first().json.Company }}\nBooking link: REPLACE_WITH_BOOKING_LINK","messages":{"messageValues":[{"message":"You are a concise human-sounding B2B outreach assistant for an automation studio. Use a discovery-first approach. For cold/warm leads, ask a relevant operational question and do not push a meeting. Only include the booking link after the lead has articulated a concrete problem and is clearly hot. If the stage is CTA Sent, Closed, Not Interested, or Followup 2 Sent with no reply, return an empty string. Output message text only."}]}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[1920,880],"id":"compose-message","name":"Compose Message"},
