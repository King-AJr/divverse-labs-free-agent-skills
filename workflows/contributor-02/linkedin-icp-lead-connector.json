    {"parameters":{"jsCode":"const rows=$input.all().map(i=>i.json),now=$now,today=now.startOf('day'),monday=now.startOf('week'),workday=now.weekday>=1&&now.weekday<=5; const normalized=rows.map(r=>({date:DateTime.fromISO(r.Date),today:Number(r['Invites Today']||0),week:r['Invites Since Monday']==null?null:Number(r['Invites Since Monday'])})).filter(r=>r.date.isValid); const tr=normalized.find(r=>r.date.hasSame(today,'day')); const wr=normalized.filter(r=>r.date>=monday&&r.week!=null).sort((a,b)=>b.date.toMillis()-a.date.toMillis()); const invitesToday=tr?.today||0,invitesSinceMonday=wr[0]?.week||0; return [{json:{inviteLimitReached:invitesToday>=(workday?20:0)||invitesSinceMonday>=100,randomWaitMinutes:Math.floor(Math.random()*4)+3}}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,-80],"id":"invite-limit","name":"Compute Invite Limit"},
