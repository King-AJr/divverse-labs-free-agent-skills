    {"parameters":{"model":"meta-llama/llama-4-maverick-17b-128e-instruct","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatGroq","typeVersion":1,"position":[468,140],"id":"groq-classifier-model","name":"Groq Chat Model"},
    {"parameters":{"promptType":"define","text":"=Target Roles: {{ $('Webhook Trigger').item.json.target_roles.join(', ') }}\nTarget Locations: {{ $('Webhook Trigger').item.json.role_location.join(', ') }}\nTarget Employment Types: {{ $('Webhook Trigger').item.json.employment_type.join(', ') }}\nLinkedIn Post: {{ $json.text }}\nID: {{ $json.urn }}","messages":{"messageValues":[{"message":"Classify whether this LinkedIn post communicates active hiring and matches the supplied role, employment-type and location filters. Return only valid JSON with: relevant, job_titles, locations, company_names, employment_types, application_deadlines, emails, application_links, additional_notes, and id. Arrays must be returned for extracted fields. Missing fields should not disqualify a post; explicit contradictions should."}]}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.6,"position":[380,-80],"id":"classify-posts","name":"Process and Classify Posts"},
