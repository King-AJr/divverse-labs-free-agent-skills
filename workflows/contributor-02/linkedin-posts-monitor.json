    {"parameters":{"path":"linkedin-posts-monitor","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-500,-180],"id":"webhook-trigger","name":"Webhook Trigger"},
    {"parameters":{"jsCode":"const results=[]; const phrases=[\"we're hiring\",\"hiring\",\"job opening\"]; for(const item of $input.all()){const json=item.json; const roles=(json.target_roles||[]).slice(0,2); const datePosted=json.date_posted||'past_week'; const sortBy=json.sort_by||'latest'; const keywords=phrases.flatMap(p=>roles.map(r=>`${p} ${r}`)).join(' OR '); const dp={past_24h:'past-24h',past_week:'past-week',past_month:'past-month'}; const sm={latest:'date_posted',top_match:'relevance'}; const params=[]; if(keywords) params.push('keywords='+encodeURIComponent(keywords)); params.push('datePosted='+encodeURIComponent(dp[datePosted]||'past-week')); params.push('sortBy='+encodeURIComponent(sm[sortBy]||'date_posted')); params.push('origin=FACETED_SEARCH'); results.push({json:{constructedUrl:'https://www.linkedin.com/search/results/content/?'+params.join('&')}});} return results;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-280,-180],"id":"construct-search-url","name":"Construct LinkedIn Post Search URL"},
