    {"parameters":{"jsCode":"return $input.all().map(item=>{try{let t=item.json.text.replace(/^\\s*```(?:json)?/i,'').replace(/```$/,'').trim(); let p=JSON.parse(t); if(typeof p==='string')p=JSON.parse(p); return {json:p};}catch(error){return {json:{error:'Invalid JSON',reason:error.message}};}});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[460,-380],"id":"parse-llm","name":"Parse LLM Output"},
