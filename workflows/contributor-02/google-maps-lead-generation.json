    {"parameters":{"jsCode":"const items=$input.all(); let max=0; for(const item of items){const d=item.json,r=+d.totalScore||0,v=parseInt(d.reviewsCount||0,10),web=!!d.website,phone=!!d.phoneUnformatted,unclaimed=!d.claimThisBusiness,closed=d.permanentlyClosed||d.temporarilyClosed; let s=r*6+Math.min(Math.log10(v+1)*4,10)+(phone?15:0)+(web?5:15)+(r>=4.5?10:r>=4?5:0)+(v>=100?5:v>=50?3:0)+(unclaimed&&!web?15:unclaimed?10:0)-(closed?100:0); d._score=s; d._facts={r,v,web,phone,unclaimed,closed}; max=Math.max(max,s);} for(const item of items){const d=item.json,f=d._facts,s=d._score; delete d._facts; delete d._score; d.leadScore=Math.round(s); d.normalizedScore=max>0?Math.round(s/max*100):0; d.leadTier=s>=65?'Hot':s>=40?'Warm':'Cold'; d.easyTarget=f.unclaimed&&!f.web?'Prime Target':f.phone&&!f.web?'Strong Opportunity':'Standard'; d.explanation=`Rating ${f.r} | ${f.v} reviews | ${f.phone?'Phone available':'No phone'} | ${f.web?'Website present':'No website'} | Score ${Math.round(s)}`;} return items;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[816,-16],"id":"lead-score","name":"Lead Scoring1"},
