    {"parameters":{"operation":"executeQuery","query":"TRUNCATE TABLE eligible_pool;\nINSERT INTO eligible_pool (member_id, username)\nSELECT m.id, m.username FROM members m\nWHERE NOT EXISTS (\n  SELECT 1 FROM role_assignments ra\n  WHERE ra.member_id=m.id::text AND ra.status IN ('pending','completed')\n);\nSELECT COUNT(*) AS eligible_members_count FROM eligible_pool;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[368,144],"id":"eligible-pool","name":"Create Eligible Member Pool"},
    {"parameters":{"operation":"executeQuery","query":"SELECT rs.role_id, rs.role_name, rs.capacity, COALESCE(ra.assigned_count,0) AS assigned_count, rs.capacity-COALESCE(ra.assigned_count,0) AS slots_left\nFROM roles_status rs\nLEFT JOIN (SELECT role_id,COUNT(*) assigned_count FROM role_assignments WHERE status IN ('pending','completed') GROUP BY role_id) ra ON rs.role_id=ra.role_id\nWHERE rs.role_name ILIKE 'team%' AND rs.is_filled=FALSE\nORDER BY rs.role_name;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[592,144],"id":"eligible-roles","name":"Select Eligible Roles"},
    {"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[816,144],"id":"role-loop","name":"Loop Over Roles"},
    {"parameters":{"operation":"executeQuery","query":"WITH slots AS (SELECT GREATEST(capacity-member_count,0) slots FROM roles_status WHERE role_id='{{ $json.role_id }}'), picked AS (SELECT member_id, username, ROW_NUMBER() OVER (ORDER BY random()) rn FROM eligible_pool) INSERT INTO role_assignments(member_id,role_id,role_name,username,status,created_at) SELECT member_id,'{{ $json.role_id }}','{{ $json.role_name }}',username,'pending',NOW() FROM picked WHERE rn <= (SELECT slots FROM slots) ON CONFLICT (member_id,role_id) DO NOTHING RETURNING *;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1040,144],"id":"insert-assignments","name":"Insert Assignments"},
