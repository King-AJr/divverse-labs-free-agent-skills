    {
      "parameters": {
        "jsCode": "// This assumes the Gmail node outputs one item per email\n// The structure might vary depending on your Gmail node settings, \n// so adjust property paths accordingly.\n\nreturn items.map(item => {\n    const data = item.json;\n\n    return {\n        json: {\n            subject: data.subject || null,\n            body: data.text || data.textAsHtml || null,\n            senderName: data.from.value[0].name || null,\n            senderEmail: data.from.value[0].address || null,\n            date: data.date || null,\n            snippet: data.snippet || null,\n            threadId: data.threadId || null,\n            id: data.id || null\n        }\n    };\n});\n"
      },
