    {
      "parameters": {
        "jsCode": "// In the n8n Function node:\n\n// Example input\nconst fullPath = $input.first().json.Key; // e.g., \"n8n image buckets/chart-20250825194719.png\"\n\n// Option 1: Using `split()` and `pop()`\nconst filename = fullPath.split(\"/\").pop();\n\n// Option 2: Using `lastIndexOf()` and `substring()`\nconst lastSlash = fullPath.lastIndexOf(\"/\");\nconst filenameAlt = lastSlash !== -1\n  ? fullPath.substring(lastSlash + 1)\n  : fullPath;\n\n// Return in correct n8n structure\nreturn [\n  {\n    json: {\n      filename: filename  // or filenameAlt, same result\n    }\n  }\n];\n"
      },
