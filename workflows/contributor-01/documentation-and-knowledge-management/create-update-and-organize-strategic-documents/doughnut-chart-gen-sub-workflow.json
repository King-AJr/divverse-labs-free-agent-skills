      "parameters": {
        "jsCode": "const randomNum = Math.floor(Math.random() * 1000000);\nconst timestamp = Date.now();\nconst randomStr = Math.floor().toString(36).substring(2, 8);\n\nreturn {\n  uniqueId: `${randomNum}-${timestamp}-${randomStr}`\n};"
