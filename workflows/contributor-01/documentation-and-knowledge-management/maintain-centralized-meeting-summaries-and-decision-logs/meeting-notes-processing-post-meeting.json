        "jsonSchemaExample": "{\n  \"meeting_title\": \"string\",\n  \"date\": \"YYYY-MM-DD or null\",\n  \"time\": \"HH:MM or null\",\n  \"participants\": [\"string\"],\n  \"decisions\": [\n    {\n      \"decision\": \"string\",\n      \"owner\": \"string\",\n      \"deadline\": \"YYYY-MM-DD or null\",\n      \"related_documents\": [\"string\"]\n    }\n  ]\n}\n"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1424,
        288
      ],
      "id": "90f7e088-6774-41f0-8901-d51d86c57584",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const input = items[0].json.output;\n\n// Helper function: turns an array into a numbered string\nfunction toNumberedList(arr) {\n  return arr.map((val, i) => `${i + 1}. ${val}`).join(\"\\n\");\n}\n\n// We'll restructure so each \"decision\" becomes a task\nconst tasks = input.decisions.map(decision => {\n  return {\n    name: decision.decision, // task title\n    assignees: [decision.owner], // ClickUp wants assignee IDs, but you can map names later\n    due_date: decision.deadline, // ClickUp API expects timestamps, we’ll format next\n    custom_fields: {\n      meeting_title: input.meeting_title,\n      meeting_date: input.date,\n      meeting_time: input.time,\n      participants: input.participants.join(\", \"),\n      related_documents: decision.related_documents.join(\", \") || \"None\"\n    }\n  };\n});\n\n// Convert due_date to ClickUp timestamp (milliseconds since epoch)\ntasks.forEach(task => {\n  if (task.due_date) {\n    task.due_date = new Date(task.due_date).getTime();\n  }\n});\n\n// Return as separate items for n8n\nreturn tasks.map(task => ({ json: task }));\n"
      },
