    {
      "parameters": {
        "jsCode": "// Extract the payload from the incoming webhook\nconst payload = $json.body;\n\n// The resultObject is a stringified JSON array — parse it\nlet results;\ntry {\n  results = JSON.parse(payload.resultObject);\n} catch (error) {\n  throw new Error('Could not parse resultObject: ' + error.message);\n}\n\n// Ensure results is always an array\nif (!Array.isArray(results)) {\n  results = [results];\n}\n\n// Map each post in the results array to separate n8n items\nreturn results.map(post => {\n  return {\n    json: {\n      agentId: payload.agentId || '',\n      agentName: payload.agentName || '',\n      containerId: payload.containerId || '',\n      script: payload.script || '',\n      branch: payload.branch || '',\n      launchDuration: payload.launchDuration || '',\n      runDuration: payload.runDuration || '',\n      exitMessage: payload.exitMessage || '',\n      exitCode: payload.exitCode || '',\n\n      // Parsed LinkedIn Post Data\n      postUrl: post.postUrl || '',\n      profileUrl: post.profileUrl || '',\n      firstName: post.firstName || '',\n      lastName: post.lastName || '',\n      fullName: post.fullName || '',\n      title: post.title || '',\n      profileImgUrl: post.profileImgUrl || '',\n      likeCount: post.likeCount || 0,\n      commentCount: post.commentCount || 0,\n      connectionDegree: post.connectionDegree || '',\n      postDate: post.postDate || '',\n      postImageURL: post.postImageURL || '',\n      postTimestamp: post.postTimestamp || '',\n      textContent: post.textContent || '',\n      query: post.query || '',\n      category: post.category || '',\n      timestamp: post.timestamp || '',\n      searchAccountFullName: post.searchAccountFullName || '',\n      searchAccountProfileId: post.searchAccountProfileId || ''\n    }\n  };\n});\n"
      },
