      "parameters": {
        "jsCode": "let start =  0 // Initial page\nconst limit = $input.first().json.output.limit; // Limit to fetch 100 profiles\nconst batchSize = 10; // Google Search returns 100 results per page\nconst output = [];\n\n// Loop through pages by increments of 100\nwhile (start < limit) {\n  output.push({ json: { start: start } });\n  start += batchSize; // increment by 100 for each page\n}\n\nreturn output;"
      },
