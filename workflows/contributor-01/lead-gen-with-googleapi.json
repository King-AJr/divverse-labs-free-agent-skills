        "jsCode": "const crypto = require('crypto');\n\nconst leads = [];\n\nfor (const item of items) {\n    const id = crypto.randomBytes(6).toString('hex'); // 12-char unique ID\n\n    leads.push({\n        json: {\n            id,\n            name: item.json.fullName ?? null,\n            title: item.json.jobTitle ?? null,\n            company: item.json.companyName ?? null,\n            location: item.json.addressWithCountry ?? null,\n            email: item.json.email ?? null,\n            linkedin: item.json.linkedinUrl ?? null,\n            snippet: item.json.about ?? null,\n            image: item.json.profilePicHighQuality ?? item.json.profilePic ?? null,\n            company_domain: item.json.companyWebsite ?? null\n        }\n    });\n}\n\nreturn leads;\n"
      },
