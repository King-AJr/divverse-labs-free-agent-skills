    {
      "parameters": {
        "jsCode": "// Get input from previous node\nconst input = items[0].json.data;\n\n// Helper to escape HTML if needed (optional)\nfunction escapeHtml(str) {\n  return str\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#039;\");\n}\n\nlet emailBody = `<div style=\"font-family: Arial, sans-serif; line-height:1.6;\">`;\n\ninput.forEach((entry, index) => {\n  const output = entry.output;\n\n  const competitorName = output[\"🏷️ Competitor Name\"] || \"Unknown Competitor\";\n  const pricingPlans = output[\"💰 Current Pricing Plans\"] || \"No pricing details.\";\n  const recentChanges = output[\"📢 Recent Changes/Updates\"] || \"No updates available.\";\n  const insights = output[\"💡 Insights for Us\"] || \"No insights.\";\n\n  emailBody += `\n    <div style=\"margin-bottom:25px; padding:15px; border:1px solid #ddd; border-radius:8px;\">\n      <h2 style=\"margin-top:0; color:#333;\">🏷️ ${competitorName}</h2>\n      <h3 style=\"color:#555;\">💰 Current Pricing Plans</h3>\n      <pre style=\"background:#f9f9f9; padding:10px; border-radius:6px; white-space:pre-wrap;\">${escapeHtml(pricingPlans)}</pre>\n      \n      <h3 style=\"color:#555;\">📢 Recent Changes/Updates</h3>\n      <p>${escapeHtml(recentChanges)}</p>\n      \n      <h3 style=\"color:#555;\">💡 Insights for Us</h3>\n      <pre style=\"background:#f0faff; padding:10px; border-radius:6px; white-space:pre-wrap;\">${escapeHtml(insights)}</pre>\n    </div>\n  `;\n});\n\nemailBody += `</div>`;\n\n// Return nicely formatted HTML as the output for email\nreturn [{\n  json: {\n    formattedEmail: emailBody\n  }\n}];\n"
      },
