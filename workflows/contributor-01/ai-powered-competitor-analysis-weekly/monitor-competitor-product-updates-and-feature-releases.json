        "mode": "runOnceForEachItem",
        "jsCode": "// Remove ```json fences, parse, and keep the array as `announcements`\nconst cleaned = $json.output\n  .replace(/```json|```/g, '') // strip fences\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // fallback if the string itself is the announcements array\n  parsed = { announcements: JSON.parse($json.text) };\n}\n\nreturn {\n  json: {\n    company: $itemIndex,     // or pass down original company key\n    announcements: parsed.announcements || [],\n  },\n};"
      },
