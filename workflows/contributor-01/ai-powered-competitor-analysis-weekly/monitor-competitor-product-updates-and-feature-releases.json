      "parameters": {
        "jsCode": "const out = []\n\nitems.forEach((itm, i) => {\n  const sheetsRow = $items(\"Get row(s) in sheet\")[i].json;\n\n  out.push({\n    json: {\n      company: sheetsRow[\"Competitor\"],  // Column A for this row\n      source: \"linkedin\",\n      analysis_linkedin: itm.json.output   // the LLM text for this company\n    }\n  });\n});\n\nreturn out;"
