    {
      "parameters": {
        "jsCode": "// Groups LinkedIn posts by company and keeps only text.\n\nconst grouped = {};\n\nfor (const { json } of items) {\n  // A stable grouping key. Source_company is present\n  // on every item scraped from Apify's LinkedIn actor\n  const key = json.source_company\n             || json.author?.company_url // fallback\n             || 'unknown';\n\n  if (!grouped[key]) {\n    grouped[key] = {\n      company: key,    // you can also store author.name here\n      posts: [],\n    };\n  }\n\n  // Keep only the text\n  grouped[key].posts.push(json.text);\n}\n\n// Return one item per company\nreturn Object.values(grouped).map(data => ({ json: data }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
