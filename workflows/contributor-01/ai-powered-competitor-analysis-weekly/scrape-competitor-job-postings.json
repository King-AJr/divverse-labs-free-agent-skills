      "parameters": {
        "jsCode": "// Get raw scraped text\nconst text = $input.first().json.data?.modelResponse?.scrapedContent?.text || \"\";\n\n// Regex to capture job blocks: [**Job Title** ...](Job URL)\nconst jobRegex = /\\[\\*\\*(.*?)\\*\\*.*?\\]\\((https:\\/\\/www\\.linkedin\\.com\\/jobs\\/view\\/[^\\)]+)\\)[\\s\\S]*?(?=Vapi|\\n\\*)/g;\n\nlet results = [];\nlet match;\n\nwhile ((match = jobRegex.exec(text)) !== null) {\n  const title = match[1].trim();\n  const url = match[2].trim();\n\n  // Try to capture location (e.g., \"San Francisco, CA (On-site)\")\n  const locMatch = text.slice(match.index, jobRegex.lastIndex).match(/San Francisco.*?\\)/);\n  const location = locMatch ? locMatch[0].trim() : \"\";\n\n  results.push({\n    jobTitle: title,\n    company: $('Loop Over Items').first().json.Name, // static here, but can expand to parse dynamic company names\n    location,\n    url\n  });\n}\n\n// Return each as an item\nreturn results.map(job => ({ json: job }));\n"
      },
