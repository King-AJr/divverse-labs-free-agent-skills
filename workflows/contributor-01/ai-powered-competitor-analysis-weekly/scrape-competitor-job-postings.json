    {
      "parameters": {
        "jsCode": "// Get the raw scraped text\nconst raw = $input.first().json.data.modelResponse.scrapedContent.text;\n\n// Regex to capture profiles\n// Pattern: [Name](profileUrl) ... Headline ... Location\nconst profileRegex = /\\[([^\\]]+)\\]\\((https:\\/\\/www\\.linkedin\\.com\\/in\\/[^\\)]+)\\)[\\s\\S]*?\\n\\n([^\\n]+)\\n\\n([^\\n]+, [^\\n]+(?:, [^\\n]+)?)/g;\n\nlet matches;\nconst results = [];\n\nwhile ((matches = profileRegex.exec(raw)) !== null) {\n  const name = matches[1]?.trim() || \"\";\n  const profileUrl = matches[2]?.trim() || \"\";\n  const headline = matches[3]?.trim() || \"\";\n  const location = matches[4]?.trim() || \"\";\n\n  results.push({\n    json: {\n      name,\n      profileUrl,\n      headline,\n      location\n    }\n  });\n}\n\nreturn results;\n"
      },
