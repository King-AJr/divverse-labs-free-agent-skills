        "jsCode": "return items.map(item => {\n  const url = item.json['LinkedIn URL'] || \"\";\n  let identifier = \"\";\n\n  try {\n    const match = url.match(/linkedin\\.com\\/company\\/([^\\/?#]+)/i);\n    if (match && match[1]) {\n      identifier = match[1];\n    }\n  } catch (e) {\n    identifier = \"\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      companyIdentifier: identifier\n    }\n  };\n});\n"
