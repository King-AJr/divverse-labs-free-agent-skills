      "parameters": {
        "jsCode": "// Nigerian dishes\nconst dishes = [\n  \"amala restaurant\",\n  \"nigerian jollof rice\",\n  \"Egusi soup\",\n  \"Nigerian fried rice\",\n  \"Ewa agoyin\",\n  \"Suya\",\n  \"Asun (goat meat)\",\n  \"Pepper Soup\",\n  \"Eba (garri)\",\n  \"Afang Soup\",\n  \"akara\",\n  \"Efo riro\",\n  \"Fried Plantain\",\n  \"moin moin\",\n  \"nigerian pepper soup restaurant\",\n  \"pounded yam\",\n  \"banga soup\",\n  \"nigerian Edikang Ikong soup\",\n  \"Ofada Rice sellers\",\n  \"ogbono soup\",\n  \"nigerian white rice and stew\",\n  \"okro soup\"\n];\n\n// States should come from previous node\nconst states = $input.first().json.States; // each has {state, latlong}\n\nconst combinations = [];\n\nfor (const dish of dishes) {\n  for (const s of states) {\n    for (let page = 1; page <= 3; page++) {\n      combinations.push({\n        json: {\n          dish,\n          state: s.state,\n          latlong: s.latlong,\n          page,\n          query: `${dish} in ${s.state} ${s.latlong}`,\n        }\n      });\n    }\n  }\n}\n\nreturn combinations;\n"
      },
