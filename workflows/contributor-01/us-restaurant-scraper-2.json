    {
      "parameters": {
        "jsCode": "// Expecting field: item.json.address\n// Example: \"2464 E State St, Burnham, IL 60633\"\n\nreturn items.map(item => {\n  const address = $input.first().json.address || \"\";\n\n  // Regex to extract: City, State, Zip\n  const regex = /,\\s*([^,]+),\\s*([A-Z]{2})\\s+(\\d{5})/i;\n  const match = address.match(regex);\n\n  let city = null;\n  let state = null;\n  let zipcode = null;\n\n  if (match) {\n    city = match[1].trim();\n    state = match[2].trim();\n    zipcode = match[3].trim();\n  }\n\n  return {\n    json: {\n      ...item.json,\n      city,\n      state,\n      zipcode\n    }\n  };\n});\n"
      },
