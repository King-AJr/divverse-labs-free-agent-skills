      "parameters": {
        "jsCode": "// Define how many numbers you want\nconst max = 5;\n\n// Generate array of numbers [1, 2, 3, 4, 5]\nconst numbers = Array.from({ length: max }, (_, i) => i + 1);\n\n// Return each number as its own item\nreturn numbers.map(num => ({\n  json: {\n    pageNumber: num\n  }\n}));\n"
