    },
    {
      "parameters": {
        "jsCode": "// Get input event link (from previous node)\nconst eventUrl = $('Get row(s) in sheet').first().json.event_url;\n// Example: \"https://www.linkedin.com/events/123456789/\"\n\n// page number\nconst pageNum = $input.first().json.pageNumber;\n\n// Extract the numeric event ID\nconst match = eventUrl.match(/events\\/(\\d+)/);\nif (!match) {\n  throw new Error(\"Event ID not found in eventUrl: \" + eventUrl);\n}\n\nconst eventId = match[1]; // e.g. \"123456789\"\n\n// Construct eventUrn\nconst eventUrn = `urn:li:event:${eventId}`;\n\n// Encode eventUrn for URL\nconst encodedUrn = encodeURIComponent(eventUrn);\n\n// Construct attendees URL\nconst attendeesUrl = `https://www.linkedin.com/search/results/people/?eventUrn=${encodedUrn}&origin=EVENT_PAGE_CANNED_SEARCH&page=${pageNum}&spellCorrectionEnabled=true`;\n\nreturn [\n  {\n    json: {\n      eventId,\n      eventUrn,\n      pageNum,\n      attendeesUrl\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
