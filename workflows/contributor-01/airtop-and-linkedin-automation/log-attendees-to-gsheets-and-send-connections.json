    {
      "parameters": {
        "content": "# Workflow Details\n\n## Trigger workflow: *Scrape Events*\n\n## Triggered when event Urls are scraped by Airtop and sent to Phantombuster for attendees extraction\n\n## This workflow receives the payload when each eventUrl is processed by phantombuster\n\n## This workflow extracts attendees from the payload of a single event and sends a connection request to each of the attendees with a personalized Icebreaker note",
        "height": 544,
        "width": 608
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -176,
        -720
      ],
      "typeVersion": 1,
      "id": "2293cc20-76be-493e-80d2-8a7d11763542",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// Get the resultObject directly from the current item\nconst body = $('Webhook').first().json.body.resultObject;\n\n// Parse the resultObject (it's a JSON string)\nlet attendees = [];\ntry {\n  attendees = JSON.parse(body);\n} catch (e) {\n  throw new Error(\"Failed to parse resultObject: \" + e.message);\n}\n\n// Extract event URL (same for all attendees)\nconst eventUrl = attendees.length > 0 ? attendees[0].query : null;\n\n// Map attendees into individual output items\nreturn attendees.map(att => {\n  return {\n    json: {\n      profileUrl: att.profileUrl || null,\n      fullName: att.fullName || null,\n      firstName: att.firstName || null,\n      lastName: att.lastName || null,\n      profileImageUrl: att.profileImageUrl || null,\n      job: att.job || null,\n      location: att.location || null,\n      degree: att.degree || null,\n      timestamp: att.timestamp || null,\n      eventUrl: eventUrl\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -48
      ],
      "id": "346063e2-0c3d-44b3-b6ac-3c4d9e7e5ec1",
      "name": "Extract Event Attendees"
    },
    {
      "parameters": {
        "jsCode": "// Get first input item\nconst item = $input.item.json;\n\n// Parse resultObject (it's a stringified JSON array)\nlet resultArray;\ntry {\n  resultArray = JSON.parse(item.body.resultObject);\n} catch (e) {\n  resultArray = [];\n}\n\n// Extract event URL from first attendee\nconst eventUrl = resultArray.length > 0 ? resultArray[0].query : null;\n\nreturn [\n  {\n    json: {\n      eventUrl\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
