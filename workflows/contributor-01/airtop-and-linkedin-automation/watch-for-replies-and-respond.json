    {
      "parameters": {
        "jsCode": "// Input: your webhook JSON (items[0].json)\n// Extract entire thread messages for AI use\n\nconst input = $('Webhook').first().json.body;\n\n// Parse the resultObject which is a JSON string\nlet conversations = [];\ntry {\n  conversations = JSON.parse(input.resultObject);\n} catch (e) {\n  throw new Error(\"Failed to parse resultObject: \" + e.message);\n}\n\nconst output = conversations.map(conv => {\n  const messages = conv.messages || [];\n\n  // Build full conversation as array of objects\n  const threadMessages = messages.map(msg => ({\n    from: msg.author,\n    name: `${msg.firstName || \"\"} ${msg.lastName || \"\"}`.trim(),\n    profileUrl: msg.profileUrl,\n    text: msg.message,\n    timestamp: msg.timestamp\n  }));\n\n  // Optionally, also create a single conversation string for AI input\n  const conversationString = threadMessages.map(\n    m => `${m.name} (${m.from}) [${m.timestamp}]: ${m.text}`\n  ).join(\"\\n\");\n\n  return {\n    json: {\n      threadId: conv.conversationUrl,\n      contactProfileUrl: conv.url,\n      contactName: threadMessages.find(m => m.from !== \"Contributor 01\")?.name || \"\",\n      lastMessage: threadMessages[threadMessages.length - 1]?.text || \"\",\n      lastMessageFrom: threadMessages[threadMessages.length - 1]?.from || \"\",\n      lastMessageTime: threadMessages[threadMessages.length - 1]?.timestamp || \"\",\n      messages: threadMessages,          // full array of messages\n      conversationText: conversationString // plain text version for AI node\n    }\n  };\n});\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
