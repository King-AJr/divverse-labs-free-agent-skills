      "parameters": {
        "jsCode": "// Extract scraped LinkedIn text from n8n input\nconst text = items[0].json.data.modelResponse.scrapedContent.text;\n\n// Regex pattern:\n// 1 = profile URL\n// 2 = name\n// 3 = headline/title\n// 4 = location\nconst regex = /\\[\\]\\((https:\\/\\/www\\.linkedin\\.com\\/in\\/[^\\)]+)\\)\\[([^\\]]+)\\]\\([^\\)]+\\)[^\\n]*\\n\\n([^\\n]+)\\n\\n([^\\n]+)/g;\n\nlet results = [];\nlet match;\n\nwhile ((match = regex.exec(text)) !== null) {\n  const profileUrl = match[1].trim();\n  const name = match[2].trim();\n  const headline = match[3].trim();\n  const location = match[4].trim();\n\n  results.push({\n    name,\n    profileUrl,\n    headline,\n    location,\n  });\n}\n\nreturn results.map(r => ({ json: r }));\n"
      },
