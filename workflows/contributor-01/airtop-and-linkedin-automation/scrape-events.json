      "parameters": {
        "jsCode": "// Get totalEvents (e.g., 47)\nconst totalEvents = $input.first().json.data.modelResponse || 0;\n\n// Events per page (LinkedIn = 10)\nconst perPage = 10;\n\n// Calculate total pages\nconst totalPages = Math.ceil(totalEvents / perPage);\n\n// Build an array of pages [1, 2, ..., totalPages]\nconst pages = Array.from({ length: totalPages }, (_, i) => i + 1);\n\n// Return each page number as a separate item\nreturn pages.map(page => ({ json: { page } }));\n"
      },
