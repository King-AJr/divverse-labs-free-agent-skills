    {
      "parameters": {
        "jsCode": "// Get the raw string from the previous node\nconst raw = $input.first().json.data.modelResponse.scrapedContent.text;\n\n// Regex to match blocks for each event, now capturing attendees too\nconst eventRegex = /\\[([^\\]]+)\\]\\((https:\\/\\/www\\.linkedin\\.com\\/events\\/[^\\)]+)\\)[\\s\\S]*?(?:\\n\\s*)([\\w, ]+\\d{1,2}, .*?(?:AM|PM) [A-Z]+)(?:\\n\\s*)(.*?)(?:\\n\\s*)([\\s\\S]*?)(?:\\n\\s*(\\d+ attendees))?/g;\n\nlet matches;\nconst results = [];\n\nwhile ((matches = eventRegex.exec(raw)) !== null) {\n  const name = matches[1].trim();\n  const eventUrl = matches[2].trim();\n  const date = matches[3].trim();\n  const locationAndBy = matches[4].trim();\n  let description = matches[5] ? matches[5].trim() : \"\";\n  let attendees = matches[6] ? matches[6].trim() : \"\";\n\n  // Split location vs organizer\n  let location = \"\";\n  if (locationAndBy.includes(\"• By\")) {\n    const [loc, ...rest] = locationAndBy.split(\"• By\");\n    location = loc.trim();\n    description = rest.join(\"• By\").trim() + (description ? \" \" + description : \"\");\n  } else {\n    location = locationAndBy;\n  }\n\n  results.push({\n    json: {\n      name,\n      eventUrl,\n      date,\n      location,\n      description,\n      attendees\n    }\n  });\n}\n\nreturn results;\n"
      },
