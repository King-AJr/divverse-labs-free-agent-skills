        "promptType": "define",
        "text": "=The original schedule is:\n\n{{ $json['originalSchedule '] }}\n\nAn updated event has been received:\n\n{{ $json.updatedEvent }}",
        "options": {
          "systemMessage": "=You are a calendar update assistant.\n\nYour task is to compare an original schedule (written as plain text) with a newly updated version of a specific event. \n\nSteps to follow:\n1. Identify the matching event in the original schedule based on the event title or summary.\n2. Compare the time and location (if available) of the event in the original schedule with the updated event.\n3. Detect any changes in the time and/or location.\n4. Return a clear update summary describing exactly what changed.\n\nUse this format:\n📌 \"[Event title]\" was moved from [original time] to [updated time].\n\nIf only the time or only the location changed, mention just that.\n\n---\n\nOriginal Schedule:\n{{ $json['originalSchedule '] }}\n\nUpdated Event:\n{{ $json.updatedEvent }}\n\nExample Output: 📌 \"Marketing Review\" was moved from 2:00 PM to 3:00 PM.\n\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
