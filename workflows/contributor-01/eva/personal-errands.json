      "name": "OpenAI"
    },
    {
      "parameters": {
        "url": "https://serpapi.com/search.json?engine=google",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "serpApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.type }}"
            },
            {
              "name": "location",
              "value": "={{ $json.location }}"
