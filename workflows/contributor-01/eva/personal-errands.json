            {
              "content": "=Today's date is {{ $now }}\nExtract the following from the request:\n- Appointment Type\n- Location\n- Preferred Date/Time\n- Any special requests\nInput:{{ $json.chatInput }} \nOutput format:\n{\n  \"type\": \"\",\n  \"location\": \"\",\n  \"datetime\": \"\",\n  \"notes\": \"\"\n}\n"
            }
          ]
        },
        "options": {}
      },
