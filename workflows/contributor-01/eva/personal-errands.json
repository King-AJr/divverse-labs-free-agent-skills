            {
              "name": "limit",
              "value": "5"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -4,
        0
      ],
      "id": "1116facf-0399-4e00-98e6-eb2dcc1bc3c2",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// This script parses the 'content' field from the OpenAI output and converts it into a proper JSON object.\n\nreturn $input.all().map(item => {\n  const rawContent = item.json.message.content;\n\n  try {\n    // Parse the stringified JSON inside 'content'\n    const parsed = JSON.parse(rawContent);\n\n    return {\n      json: {\n        type: parsed.type,\n        location: parsed.location,\n        datetime: parsed.datetime,\n        notes: parsed.notes\n      }\n    };\n  } catch (error) {\n    // Return the error if parsing fails\n    return {\n      json: {\n        error: 'Invalid JSON content',\n        details: error,\n        rawContent\n      }\n    };\n  }\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        75
      ],
      "id": "3d564005-f11d-4b4f-8969-4e84c30700e5",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// Extract name, phone, address, and closing hour from SerpAPI results\n\nconst data = $input.first().json.local_results.places;\n\nconst results = data.map(place => {\n  const rawHours = place.hours || 'N/A';\n\n  let closingHour;\n\n  // If open 24 hours\n  if (/24\\s*hours/i.test(rawHours)) {\n    closingHour = '24 Hours';\n  } else {\n    // Try to extract after \"Closes \" (e.g., \"Open ⋅ Closes 6 PM\")\n    const match = rawHours.match(/Closes\\s(.+)/i);\n    closingHour = match ? match[1].trim() : 'Unknown';\n  }\n\n  return {\n    business_name: place.title,\n    business_phone: place.phone || 'N/A',\n    business_location: place.address || 'N/A',\n    closing_hour: closingHour\n  };\n});\n\nreturn results.map(entry => ({ json: entry }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        216,
        0
      ],
      "id": "2e96eb19-658a-4509-b69f-92c61574575c",
