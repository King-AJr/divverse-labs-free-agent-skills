    {
      "parameters": {
        "jsCode": "const input = items[0].json;\n\nfunction formatDate(ms) {\n  const date = new Date(Number(ms));\n  const year = date.getFullYear();\n  const month = `${date.getMonth() + 1}`.padStart(2, '0');\n  const day = `${date.getDate()}`.padStart(2, '0');\n  const hours = `${date.getHours()}`.padStart(2, '0');\n  const minutes = `${date.getMinutes()}`.padStart(2, '0');\n  return `${year}-${month}-${day} ${hours}:${minutes}`;\n}\n\nlet tasks = [];\n\nfor (let i = 0; i < input[\"task name\"].length; i++) {\n  tasks.push({\n    name: input[\"task name\"][i],\n    description: input[\"task description\"][i],\n    status: input[\"task status\"][i],\n    assignee: input[\"assignee\"][i],\n    assignee_email: input[\"assignee's email\"][i],\n    due_date: formatDate(input[\"due_date\"][i]),\n    priority: input[\"task priority\"][i]\n  });\n}\n\nreturn [\n  {\n    json: {\n      task_json: JSON.stringify(tasks, null, 2)\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
