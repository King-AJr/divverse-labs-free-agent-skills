    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Input: email text in `items[0].json.emailText`\n// Example: Subject: ... \\n\\n Hi ... \\n\\n ... Best regards, ...\n\nconst input = $('AI Agent').first().json.output.email || \"\";\n\n// Split subject\nlet subjectMatch = input.match(/^Subject:\\s*(.*)$/m);\nlet subject = subjectMatch ? subjectMatch[1].trim() : \"\";\n\n// Try to separate body after subject\nlet bodyText = input.replace(/^Subject:.*\\n*/, \"\").trim();\n\n// Extract salutation (common endings like \"Best regards\", \"Cheers\", etc.)\nlet salutationMatch = bodyText.match(/(Best regards,|Kind regards,|Regards,|Sincerely,|Thanks,|Thank you,|Cheers,)([\\s\\S]*)$/i);\n\nlet salutation = \"\";\nif (salutationMatch) {\n  salutation = salutationMatch[1].trim();\n  // Remove salutation part from body\n  bodyText = bodyText.replace(salutationMatch[0], \"\").trim();\n}\n\nreturn {\n  json: {\n    subject,\n    body: bodyText,\n    salutation\n  }\n};"
      },
