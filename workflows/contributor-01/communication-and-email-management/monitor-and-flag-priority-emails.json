    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1264,
        -80
      ],
      "id": "d687cb11-ba95-450d-8ece-00190ea7bb9e",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "// Get the aggregated priority array from the first item\nconst priorityItems = items[0].json.data;\n\n// Build the summary\nlet summary = `🚨 **High Priority Email Summary** 🚨\\n\\n`;\npriorityItems.forEach((item, index) => {\n    const out = item.output;\n    summary += `${index + 1}. **Sender:** ${out.sender}\\n`;\n    summary += `   **Required Action:** ${out.requiredAction}\\n`;\n    summary += `   **Deadline:** ${out.deadline}\\n\\n`;\n});\n\n// Add note to executive\nconst note = `⚠️ These tasks need immediate attention. Please review and take action promptly.`;\n\n// Return the formatted message\nreturn [\n    {\n        json: {\n            messageToExecutive: `${note}\\n\\n${summary}`\n        }\n    }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -80
      ],
      "id": "e704a8c6-d105-4c84-b5bd-db8105eef7db",
      "name": "Code"
    },
    {
      "parameters": {
        "sendTo": "alabiayomide14@gmail.com",
        "subject": "Needs Immediate Attention!",
        "emailType": "text",
        "message": "={{ $json.messageToExecutive }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
