      "id": "2e199f21-8907-4c42-991b-d5b94ac24d2c",
      "name": "Get many messages"
    },
    {
      "parameters": {
        "jsCode": "// This assumes the Gmail node outputs one item per email\n// The structure might vary depending on your Gmail node settings, \n// so adjust property paths accordingly.\n\nreturn items.map(item => {\n    const data = item.json;\n\n    return {\n        json: {\n            subject: data.subject || null,\n            body: data.text || data.textAsHtml || null,\n            senderName: data.from.value[0].name || null,\n            senderEmail: data.from.value[0].address || null,\n            date: data.date || null,\n            snippet: data.snippet || null,\n            threadId: data.threadId || null,\n            id: data.id || null\n        }\n    };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "1d73e19e-62aa-4db2-b691-a1f965460f68",
      "name": "Extract Subject and Body"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Email: {{ $json.senderEmail }}\nSender: {{ $json.senderName }}\nSubject: {{$json[\"subject\"]}}\nBody: {{ $json.body }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an email priority assistant. For the email below, decide if it's HIGH priority or not.  \n\nReturn JSON with:\n- priority: \"high\" or \"low\"\n- sender\n- subject\n- requiredAction (short phrase)\n- deadline (if any, else \"\")\n\nEmail: {{ $json.senderEmail }}\nSender: {{ $json.senderName }}\nSubject: {{$json[\"subject\"]}}\nBody: {{ $json.body }}\n"
        }
      },
