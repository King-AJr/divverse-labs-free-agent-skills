      "parameters": {
        "jsCode": "// YOU WILL MAP THESE IN THE CODE NODE UI:\n// Input 1: Map to states data\n// Input 2: Map to search terms data\n\nconst items = $input.all();\n\n// Get states - you'll map this\nconst statesInput = items[0].json;\nconst states = $input.first().json['all states'].all_states; // Adjust path if needed\n\n// Get search terms - you'll map this  \nconst searchInput = $input.first().json['all states'].all_states;\nconst searchTerms = $('AI Agent').first().json.output.search_terms;\nconst cuisineType = $('AI Agent').first().json.output.cuisine_type;\n\n// Generate combinations\nconst combinations = [];\n\nfor (const state of states) {\n  for (const searchTerm of searchTerms) {\n    combinations.push({\n      state_name: state.name,\n      state_abbr: state.abbr,\n      search_term: searchTerm,\n      cuisine_type: cuisineType,\n      search_query: `${searchTerm} in ${state.name}`,\n      full_query: `${searchTerm} ${state.name}`\n    });\n  }\n}\n\nreturn combinations.map(combo => ({ json: combo }));"
      },
